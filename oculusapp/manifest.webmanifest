{
  "id": "/oculusapp/",
  "name": "J.A.R. AR-Client — Sichtung im Blickfeld",
  "short_name": "J.A.R. AR",
  "description": "Sichtung im Blickfeld: Vorsichtung nach mSTaRT, ärztliche Sichtung, Umhängekarten und Behandlung — im Headset über WebXR, flach auf Handy und Laptop.",
  "lang": "de",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#101418",
  "theme_color": "#101418",
  "categories": ["medical", "education", "utilities"],
  "icons": [
    {
      "src": "assets/icon/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Simulation",
      "short_name": "Simulation",
      "description": "Der Ablauf ohne Kamera und ohne Headset",
      "url": "./index.html?mode=sim"
    },
    {
      "name": "Kamera-Modus",
      "short_name": "Kamera",
      "description": "Derselbe Ablauf flach, mit echtem QR-Scan",
      "url": "./index.html?mode=cam"
    }
  ]
}
