# TriARge hub configuration — copy to your shell profile or export before
# starting the hub. Everything has offline-safe defaults; nothing is required.

# Network
#TRIARGE_HOST=0.0.0.0
#TRIARGE_PORT=8087

# Local speech-to-text (faster-whisper): tiny|base|small|medium|large-v3
#TRIARGE_STT_MODEL=small
#TRIARGE_STT_LANGUAGE=de

# Local LLM structuring via Ollama (falls back to rule-based extractor)
#TRIARGE_OLLAMA_URL=http://127.0.0.1:11434
#TRIARGE_OLLAMA_MODEL=llama3.1:8b

# Radio (Sprechfunk) capture: sounddevice index or name substring;
# empty = default input device (built-in mic / AUX interface)
#TRIARGE_RADIO_DEVICE=

# Optional hybrid Supabase sync — leave unset for fully offline operation
#TRIARGE_SUPABASE_URL=https://<project>.supabase.co
#TRIARGE_SUPABASE_KEY=<service-role-key>
#TRIARGE_INCIDENT_ID=manv-2026-07-03-a8

# Client
#TRIARGE_HUB_URL=http://192.168.0.10:8087
#TRIARGE_MEDIC_ID=RTW-1
